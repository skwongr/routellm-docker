# RouteLLM Environment Variables
# Copy this file to .env and configure

# Strong model - for complex queries needing more capability
# Examples: ollama_chat/llama3, gpt-4o, claude-3-opus
STRONG_MODEL=ollama_chat/llama3

# Weak model - for simple queries (faster & cheaper)
WEAK_MODEL=ollama_chat/phi3

# API endpoint (Ollama or any OpenAI-compatible API)
API_BASE=http://host.docker.internal:11434/v1
API_KEY=ollama

PORT=6060