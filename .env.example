# RouteLLM Environment Variables
# Copy this file to .env and configure your models

# ===========================================
# BERT Router: No OpenAI API key needed!
# ===========================================
# The BERT router classifies prompts locally without external APIs

# Strong model (for complex queries that need GPT-4 level)
# Options:
#   - Ollama: ollama_chat/llama3 (http://host.docker.internal:11434/v1)
#   - OpenAI: gpt-4o (https://api.openai.com/v1)
#   - Anthropic: anthropic/claude-3-opus-20240229
#   - Together: togetherai/meta-llama/Llama-3-70b-instruct
STRONG_MODEL=ollama_chat/llama3
STRONG_MODEL_API_KEY=ollama  # dummy for local Ollama
STRONG_MODEL_API_BASE=http://host.docker.internal:11434/v1

# Weak model (for simple queries - faster & cheaper)
# Use a smaller model like phi3, mistral, or llama3:8b
WEAK_MODEL=ollama_chat/phi3
WEAK_MODEL_API_KEY=ollama
WEAK_MODEL_API_BASE=http://host.docker.internal:11434/v1

# Server port
PORT=6060